generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("ID")
  slug             String    @unique
  title            String
  description      String
  category         String
  venue            String    @default("To be Decided")
  startsAt         DateTime  @db.Date
  endsAt           DateTime? @db.Date
  tags             String
  featured         Boolean   @default(false)
  schedule         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  posterUrl        String?
  registrationLink String?
  rsvps            Rsvp[]
}

model Rsvp {
  id        String   @id @default(cuid())
  name      String
  email     String
  createdAt DateTime @default(now())
  eventId   String   @db.Uuid @map("eventid")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model JoinRequest {
  id         String    @id @default(cuid())
  name       String
  email      String
  branch     String
  year       String
  interest   String
  message    String?
  status     String    @default("pending")
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())
}
